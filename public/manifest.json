{
  "manifest_version": 3,
  "name": "Typadoo",
  "version": "0.1.0",
  "minimum_chrome_version": "96",
  "description": "Less typing. More doing.",
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Typadoo",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
